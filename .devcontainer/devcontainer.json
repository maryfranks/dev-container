{
  "name": "Modular Dev Container",
  "image": "<your-dockerhub-user>/devcontainer:latest",
  "remoteUser": "dev",
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK:/dev/null},target=/ssh-agent,type=bind"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "<owner>/*": {
          "permissions": "write-all"
        }
      }
    }
  },
  "postCreateCommand": "./bootstrap.sh",
  "waitFor": "postCreateCommand"
}
